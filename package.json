{
  "name": "fluido",
  "version": "0.0.1",
  "description": "Lettore PDF open source con modalità di lettura fluida. PWA statica, nessun backend.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.49",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^20",
    "eslint": "^9",
    "globals": "^15",
    "preact-render-to-string": "^6.5.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.12"
  }
}
